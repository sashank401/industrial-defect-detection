      "title": "Edge FPS Throughput",
      "type": "gauge",
      "targets": [{ "expr": "defect_detection_fps", "legendFormat": "FPS" }],
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "max": 60,
          "thresholds": {
            "mode": "absolute",
